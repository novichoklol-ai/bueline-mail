# BueLine Mail environment file — copy to /etc/bueline/mailrelay.env, chmod 600.
# Each MAILRELAY_TOKEN_<BOX> defines one mailbox (box name is lower-cased).
# Generate with: openssl rand -hex 24
MAILRELAY_TOKEN_ALICE=change-me-alice
MAILRELAY_TOKEN_BOB=change-me-bob
MAILRELAY_TOKEN_CAROL=change-me-carol

# Optional tuning (defaults shown):
# MAILRELAY_STALE_MINUTES=45
# MAILRELAY_MAX_BODY=65536
